{
  "ignoreFiles": ["node_modules/**", ".next/**"],
  "rules": {
    "property-disallowed-list": [
      "margin-left", "margin-right", "padding-left", "padding-right", "left", "right", "border-left", "border-right",
      "/^border-(left|right)-/",
      "/^border-(top|bottom)-(left|right)-radius$/",
      "/^scroll-(margin|padding)-(left|right)$/"
    ],
    "declaration-property-value-disallowed-list": {
      "text-align": ["left", "right"],
      "float": ["left", "right"],
      "clear": ["left", "right"],
      "/^(-webkit-)?(background|background-image|mask|mask-image|border-image|border-image-source)$/": [
        "/\\bto\\s+((top|bottom)\\s+)?(left|right)\\b/"
      ],
      "transform-origin": ["/\\b(left|right)\\b/"]
    }
  }
}
