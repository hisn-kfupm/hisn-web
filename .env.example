# --- Added by A-2 ---

# Talent database (HR-1). Read only by lib/db/talent.ts.
# Locally = the same values as NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Production values (hisn-talent) live only in Vercel production env, never here.
TALENT_SUPABASE_URL=
TALENT_SUPABASE_ANON_KEY=

# fill from: supabase status
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=
MAIL_CATCHER_URL=http://127.0.0.1:54324

TALENT_FORM_OPEN=false
LIBRARY_REQUIRES_SIGN_IN=false

# Local mail goes to the Supabase mail catcher (supabase/config.toml [local_smtp] smtp_port).
EMAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=54325

SITE_URL=http://localhost:3000
